rules_version = '2';

// Regras de segurança do listRats (v11).
// Cole este arquivo inteiro em: Firebase > Firestore Database > Regras > Publicar.
//
// Resumo:
// - "usernames" só pode ser consultado por nome exato (para entrar com o usuário); ninguém lista;
// - o resto só quem está logado lê;
// - qualquer pessoa logada cria projetos e vira o DONO DO PROJETO (campo owner);
// - o dono do projeto edita, apaga, tira integrantes, escolhe ajudantes do projeto e pode passar o projeto;
// - ninguém é colocado num projeto direto: o dono manda um convite (pedidos) e a pessoa aceita, ou ela entra por link;
// - amizades: um pede, o outro aceita; cada um vê só as próprias;
// - notificações: qualquer um logado avisa outra pessoa; só quem recebe lê, marca como lida e apaga;
// - o dono do projeto pode mexer em todas as listRats e tarefas do projeto;
// - qualquer integrante de um projeto cria listRats nele (coleção subprojetos) e vira o dono delas;
// - o dono da listRat edita (nome, detalhes, início e fim), apaga e escolhe ajudantes;
// - TAREFAS: cada pessoa só cria, edita e apaga as PRÓPRIAS (nas inscrições); depois que a listRat começa, só renomeia;
//   ninguém (nem dono nem ajudante) mexe na tarefa de outra pessoa; o dono da listRat/projeto só apaga ao apagar a listRat;
// - justificativas: quem não fez justifica; dono/ajudantes da listRat aceitam ou recusam;
// - contestações: no dia seguinte ao fim da listRat, participante contesta tarefa de outro (uma vez por tarefa);
//   o contestado manda a prova até o fim do dia; dono/ajudantes aceitam ou recusam a prova;
// - quem tem um link de convite válido pode se colocar como integrante do projeto do convite;
// - só o dono do projeto cria links de convite; cada um só vê os links que criou;
// - cada jogador só grava o próprio documento players/<seu uid>;
// - cada jogador só cria e apaga as próprias fotos.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function project(pid) {
      return get(/databases/$(database)/documents/projetos/$(pid)).data;
    }
    function isProjectMember(pid) {
      return signedIn() && request.auth.uid in project(pid).members;
    }
    function isProjectOwner(pid) {
      return signedIn() && project(pid).get('owner', '') == request.auth.uid;
    }
    // dono ou ajudante da listRat, ou dono do projeto dela
    function canEditSub(sid) {
      let s = get(/databases/$(database)/documents/subprojetos/$(sid)).data;
      return signedIn()
        && (s.get('owner', '') == request.auth.uid
          || request.auth.uid in s.get('helpers', [])
          || isProjectOwner(s.projectId));
    }
    // detalhes (até 500 letras) e datas de início/fim da listRat ("" = sem data)
    function subInfoOk(d) {
      return d.get('desc', '') is string && d.get('desc', '').size() <= 500
        && d.get('start', '') is string && d.get('start', '').size() <= 10
        && d.get('end', '') is string && d.get('end', '').size() <= 10;
    }
    // formato de um projeto: o dono precisa ser integrante
    function projectOk(d) {
      return d.keys().hasOnly(['name', 'desc', 'members', 'owner', 'helpers', 'createdAt', 'joinedVia'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && d.get('desc', '') is string && d.get('desc', '').size() <= 200
        && d.members is list && d.members.size() <= 50
        && d.owner is string && d.owner in d.members
        && d.get('helpers', []) is list && d.members.hasAll(d.get('helpers', []));
    }

    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && name.matches('^[a-z0-9_.]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'email', 'pending'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'pending'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // antigo "dono da liga": não é mais usado (só lido para projetos antigos sem dono)
    match /config/liga {
      allow read: if signedIn();
      allow write: if false;
    }

    match /projetos/{id} {
      allow read: if signedIn();
      // qualquer um cria; quem cria é o dono
      allow create: if signedIn()
        && projectOk(request.resource.data)
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      // o dono edita (inclusive passar o projeto para outro integrante) e apaga,
      // mas não coloca ninguém novo: integrantes só podem sair
      allow update: if signedIn()
        && resource.data.get('owner', '') == request.auth.uid
        && projectOk(request.resource.data)
        && resource.data.members.hasAll(request.resource.data.members);
      allow delete: if signedIn() && resource.data.get('owner', '') == request.auth.uid;
      // entrar pelo link de convite: só se acrescentar a si mesmo, com um convite válido deste projeto
      allow update: if signedIn() && joinByInvite(id);
      // aceitar um convite (pedido) que o dono mandou para mim
      allow update: if signedIn() && joinByRequest(id);
    }

    function joinByRequest(pid) {
      let rq = get(/databases/$(database)/documents/pedidos/$(pid + '_' + request.auth.uid)).data;
      return request.resource.data.get('joinedVia', '') == 'pedido'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinedVia'])
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        && request.resource.data.members.size() <= 50
        && rq.to == request.auth.uid
        && rq.projectId == pid;
    }

    // convites para projetos: id = <projeto>_<pessoa>; o dono do projeto manda, a pessoa aceita ou recusa
    match /pedidos/{id} {
      allow read: if signedIn()
        && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['projectId', 'projectName', 'from', 'to', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && id == request.resource.data.projectId + '_' + request.resource.data.to
        && request.resource.data.projectName is string && request.resource.data.projectName.size() <= 60
        && isProjectOwner(request.resource.data.projectId)
        && !(request.resource.data.to in project(request.resource.data.projectId).members);
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid
          || isProjectOwner(resource.data.projectId));
    }

    // amizades: id = <menor uid>_<maior uid>
    match /amizades/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['users', 'from', 'to', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && request.resource.data.users is list && request.resource.data.users.size() == 2
        && request.resource.data.users[0] < request.resource.data.users[1]
        && request.resource.data.users.hasAll([request.resource.data.from, request.resource.data.to])
        && id == request.resource.data.users[0] + '_' + request.resource.data.users[1];
      // só quem recebeu o pedido aceita
      allow update: if signedIn()
        && resource.data.to == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt'])
        && request.resource.data.status == 'accepted';
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // notificações
    match /notificacoes/{id} {
      allow read: if signedIn() && resource.data.to == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['to', 'from', 'cat', 'kind', 'text', 'projectId', 'sid', 'createdAt', 'read'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && request.resource.data.cat in ['projetos', 'amizades', 'site']
        && request.resource.data.kind is string && request.resource.data.kind.size() <= 30
        && request.resource.data.text is string && request.resource.data.text.size() <= 200
        && request.resource.data.read == false;
      allow update: if signedIn()
        && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signedIn() && resource.data.to == request.auth.uid;
    }

    function joinByInvite(pid) {
      let token = request.resource.data.get('joinedVia', '');
      let inv = get(/databases/$(database)/documents/convites/$(token)).data;
      return token is string && token.size() == 32
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinedVia'])
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        && request.resource.data.members.size() <= 50
        && inv.projectId == pid
        && inv.expiresAt > request.time.toMillis();
    }

    // links de convite: o código é o próprio id (32 letras aleatórias); só dá para ler sabendo o código
    match /convites/{token} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow create: if signedIn()
        && token.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['projectId', 'expiresAt', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.projectId is string
        && request.resource.data.expiresAt is number
        && isProjectOwner(request.resource.data.projectId);
      allow update: if false;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /subprojetos/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && (isProjectMember(request.resource.data.projectId) || isProjectOwner(request.resource.data.projectId))
        && request.resource.data.keys().hasOnly(['projectId', 'name', 'desc', 'start', 'end', 'status', 'req', 'participants', 'startedAt', 'joined', 'owner', 'helpers', 'createdAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && subInfoOk(request.resource.data)
        && request.resource.data.helpers is list && request.resource.data.helpers.size() <= 20;
      // dono do projeto: tudo (sem trocar a listRat de projeto)
      allow update: if (isProjectOwner(resource.data.projectId)
          && request.resource.data.projectId == resource.data.projectId
          && subInfoOk(request.resource.data))
        // dono da listRat
        || (signedIn()
          && resource.data.get('owner', '') == request.auth.uid
          && request.resource.data.owner == resource.data.owner
          && request.resource.data.projectId == resource.data.projectId
          && subInfoOk(request.resource.data)
          && request.resource.data.helpers is list && request.resource.data.helpers.size() <= 20)
        // ajudantes: só regras de inscrição, começar a listRat e participantes
        || (signedIn()
          && request.auth.uid in resource.data.get('helpers', [])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['req', 'status', 'participants', 'startedAt', 'joined']));
      allow delete: if (signedIn() && resource.data.get('owner', '') == request.auth.uid)
        || isProjectOwner(resource.data.projectId);
    }

    function sub(sid) {
      return get(/databases/$(database)/documents/subprojetos/$(sid)).data;
    }
    // dono da listRat ou dono do projeto dela (podem apagar a listRat inteira, com as tarefas)
    function ownsSub(sid) {
      let s = sub(sid);
      return signedIn() && (s.get('owner', '') == request.auth.uid || isProjectOwner(s.projectId));
    }
    // quem julga justificativas e provas: dono, ajudantes da listRat e dono do projeto
    function judgesSub(sid) { return canEditSub(sid); }
    function inscricoes(sid) { return sub(sid).get('status', 'ativa') == 'inscricoes'; }

    // tarefas: cada pessoa só mexe nas próprias
    match /tarefas/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.assignee == request.auth.uid
        && inscricoes(request.resource.data.subId)
        && isProjectMember(sub(request.resource.data.subId).projectId);
      allow update: if signedIn()
        && resource.data.assignee == request.auth.uid
        && request.resource.data.assignee == resource.data.assignee
        && request.resource.data.subId == resource.data.subId
        && (inscricoes(resource.data.subId)
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title']));
      allow delete: if (signedIn() && resource.data.assignee == request.auth.uid && inscricoes(resource.data.subId))
        || ownsSub(resource.data.subId);
    }

    // justificativa: id = <tarefa>_<dia>
    match /justificativas/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['taskId', 'subId', 'projectId', 'uid', 'key', 'comment', 'photo', 'status', 'decidedBy', 'createdAt', 'decidedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.comment is string && request.resource.data.comment.size() >= 1 && request.resource.data.comment.size() <= 300
        && id == request.resource.data.taskId + '_' + request.resource.data.key
        && get(/databases/$(database)/documents/tarefas/$(request.resource.data.taskId)).data.assignee == request.auth.uid
        && get(/databases/$(database)/documents/tarefas/$(request.resource.data.taskId)).data.subId == request.resource.data.subId;
      // quem julga muda só o resultado
      allow update: if judgesSub(resource.data.subId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedBy', 'decidedAt'])
        && request.resource.data.status in ['aceita', 'recusada']
        && request.resource.data.decidedBy == request.auth.uid;
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'pendente')
        || ownsSub(resource.data.subId);
    }

    // dia de contestação = dia seguinte ao fim da listRat (folga de algumas horas por causa do fuso)
    function endOf(sid) {
      let e = sub(sid).get('end', '');
      return timestamp.date(int(e[0:4]), int(e[5:7]), int(e[8:10]));
    }
    function inContestDay(sid) {
      return sub(sid).get('end', '') != ''
        && request.time > endOf(sid) + duration.value(1, 'd')
        && request.time < endOf(sid) + duration.value(54, 'h');
    }

    // contestação: id = id da tarefa (cada tarefa só pode ser contestada uma vez)
    match /contestacoes/{tid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['taskId', 'subId', 'projectId', 'by', 'accused', 'status', 'proofPhoto', 'proofComment', 'proofAt', 'decidedBy', 'createdAt'])
        && request.resource.data.taskId == tid
        && request.resource.data.by == request.auth.uid
        && request.resource.data.status == 'aberta'
        && get(/databases/$(database)/documents/tarefas/$(tid)).data.assignee == request.resource.data.accused
        && get(/databases/$(database)/documents/tarefas/$(tid)).data.subId == request.resource.data.subId
        && request.resource.data.accused != request.auth.uid
        && isProjectMember(sub(request.resource.data.subId).projectId)
        && inContestDay(request.resource.data.subId);
      // a pessoa contestada manda a prova (no dia de contestação)
      allow update: if signedIn()
        && resource.data.accused == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'proofPhoto', 'proofComment', 'proofAt'])
        && request.resource.data.status == 'provada'
        && request.resource.data.proofComment is string && request.resource.data.proofComment.size() <= 300
        && inContestDay(resource.data.subId);
      // quem julga aceita ou recusa a prova
      allow update: if judgesSub(resource.data.subId)
        && resource.data.accused != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedBy'])
        && request.resource.data.status in ['aceita', 'recusada']
        && request.resource.data.decidedBy == request.auth.uid;
      allow delete: if (signedIn() && resource.data.by == request.auth.uid && resource.data.status == 'aberta')
        || ownsSub(resource.data.subId);
    }

    match /players/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nick', 'done', 'proofs', 'notes', 'updatedAt', 'weeks'])
        && request.resource.data.nick is string
        && request.resource.data.nick.size() >= 1
        && request.resource.data.nick.size() <= 20
        && request.resource.data.done is map
        && request.resource.data.proofs is map
        && request.resource.data.get('notes', {}) is map;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /fotos/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'data', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
