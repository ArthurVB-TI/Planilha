rules_version = '2';

// Regras de segurança da Liga das Tarefas.
// Cole este arquivo inteiro em: Firebase > Firestore Database > Regras > Publicar.
//
// Resumo:
// - "usernames" só pode ser consultado por nome exato (para entrar com o usuário); ninguém lista;
// - o resto só quem está logado lê;
// - qualquer pessoa logada cria projetos e vira o DONO DO PROJETO (campo owner);
// - o dono do projeto edita, apaga, escolhe os integrantes e pode passar o projeto para outro integrante;
// - o dono do projeto pode mexer em todas as listRats e tarefas do projeto;
// - qualquer integrante de um projeto cria listRats nele (coleção subprojetos) e vira o dono delas;
// - o dono da listRat edita (nome, detalhes, início e fim), apaga e escolhe ajudantes; dono e ajudantes cuidam das tarefas;
// - quem tem um link de convite válido pode se colocar como integrante do projeto do convite;
// - só o dono do projeto cria links de convite; cada um só vê os links que criou;
// - listRat nova fica em inscrições: cada integrante cria/edita/apaga as próprias tarefas dela;
// - cada jogador só grava o próprio documento players/<seu uid>;
// - cada jogador só cria e apaga as próprias fotos.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function project(pid) {
      return get(/databases/$(database)/documents/projetos/$(pid)).data;
    }
    function isProjectMember(pid) {
      return signedIn() && request.auth.uid in project(pid).members;
    }
    function isProjectOwner(pid) {
      return signedIn() && project(pid).get('owner', '') == request.auth.uid;
    }
    // dono ou ajudante da listRat, ou dono do projeto dela
    function canEditSub(sid) {
      let s = get(/databases/$(database)/documents/subprojetos/$(sid)).data;
      return signedIn()
        && (s.get('owner', '') == request.auth.uid
          || request.auth.uid in s.get('helpers', [])
          || isProjectOwner(s.projectId));
    }
    // detalhes (até 500 letras) e datas de início/fim da listRat ("" = sem data)
    function subInfoOk(d) {
      return d.get('desc', '') is string && d.get('desc', '').size() <= 500
        && d.get('start', '') is string && d.get('start', '').size() <= 10
        && d.get('end', '') is string && d.get('end', '').size() <= 10;
    }
    // formato de um projeto: o dono precisa ser integrante
    function projectOk(d) {
      return d.keys().hasOnly(['name', 'desc', 'members', 'owner', 'createdAt', 'joinedVia'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && d.get('desc', '') is string && d.get('desc', '').size() <= 200
        && d.members is list && d.members.size() <= 50
        && d.owner is string && d.owner in d.members;
    }

    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && name.matches('^[a-z0-9_.]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // antigo "dono da liga": não é mais usado (só lido para projetos antigos sem dono)
    match /config/liga {
      allow read: if signedIn();
      allow write: if false;
    }

    match /projetos/{id} {
      allow read: if signedIn();
      // qualquer um cria; quem cria é o dono
      allow create: if signedIn()
        && projectOk(request.resource.data)
        && request.resource.data.owner == request.auth.uid;
      // o dono edita (inclusive passar o projeto para outro integrante) e apaga
      allow update: if signedIn()
        && resource.data.get('owner', '') == request.auth.uid
        && projectOk(request.resource.data);
      allow delete: if signedIn() && resource.data.get('owner', '') == request.auth.uid;
      // entrar pelo link de convite: só se acrescentar a si mesmo, com um convite válido deste projeto
      allow update: if signedIn() && joinByInvite(id);
    }

    function joinByInvite(pid) {
      let token = request.resource.data.get('joinedVia', '');
      let inv = get(/databases/$(database)/documents/convites/$(token)).data;
      return token is string && token.size() == 32
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinedVia'])
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        && request.resource.data.members.size() <= 50
        && inv.projectId == pid
        && inv.expiresAt > request.time.toMillis();
    }

    // links de convite: o código é o próprio id (32 letras aleatórias); só dá para ler sabendo o código
    match /convites/{token} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow create: if signedIn()
        && token.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['projectId', 'expiresAt', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.projectId is string
        && request.resource.data.expiresAt is number
        && isProjectOwner(request.resource.data.projectId);
      allow update: if false;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /subprojetos/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && (isProjectMember(request.resource.data.projectId) || isProjectOwner(request.resource.data.projectId))
        && request.resource.data.keys().hasOnly(['projectId', 'name', 'desc', 'start', 'end', 'status', 'req', 'participants', 'startedAt', 'joined', 'owner', 'helpers', 'createdAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && subInfoOk(request.resource.data)
        && request.resource.data.helpers is list && request.resource.data.helpers.size() <= 20;
      // dono do projeto: tudo (sem trocar a listRat de projeto)
      allow update: if (isProjectOwner(resource.data.projectId)
          && request.resource.data.projectId == resource.data.projectId
          && subInfoOk(request.resource.data))
        // dono da listRat
        || (signedIn()
          && resource.data.get('owner', '') == request.auth.uid
          && request.resource.data.owner == resource.data.owner
          && request.resource.data.projectId == resource.data.projectId
          && subInfoOk(request.resource.data)
          && request.resource.data.helpers is list && request.resource.data.helpers.size() <= 20)
        // ajudantes: só regras de inscrição, começar a listRat e participantes
        || (signedIn()
          && request.auth.uid in resource.data.get('helpers', [])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['req', 'status', 'participants', 'startedAt', 'joined']));
      allow delete: if (signedIn() && resource.data.get('owner', '') == request.auth.uid)
        || isProjectOwner(resource.data.projectId);
    }

    // em inscrições, cada integrante do projeto mexe nas próprias tarefas da listRat
    function selfFill(sid, assignee) {
      let s = get(/databases/$(database)/documents/subprojetos/$(sid)).data;
      return signedIn()
        && s.get('status', 'ativa') == 'inscricoes'
        && assignee == request.auth.uid
        && request.auth.uid in project(s.projectId).members;
    }

    match /tarefas/{id} {
      allow read: if signedIn();
      allow create: if canEditSub(request.resource.data.subId)
        || selfFill(request.resource.data.subId, request.resource.data.assignee);
      allow update: if (canEditSub(resource.data.subId) && request.resource.data.subId == resource.data.subId)
        || (selfFill(resource.data.subId, resource.data.assignee)
          && request.resource.data.subId == resource.data.subId
          && request.resource.data.assignee == resource.data.assignee);
      allow delete: if canEditSub(resource.data.subId)
        || selfFill(resource.data.subId, resource.data.assignee);
    }

    match /players/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nick', 'done', 'proofs', 'updatedAt', 'weeks'])
        && request.resource.data.nick is string
        && request.resource.data.nick.size() >= 1
        && request.resource.data.nick.size() <= 20
        && request.resource.data.done is map
        && request.resource.data.proofs is map;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /fotos/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'data', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
